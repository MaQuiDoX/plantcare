NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_URL=http://localhost:3000

# Fase 4: solo servidor. Nunca usar NEXT_PUBLIC_ para estas claves.
SUPABASE_SECRET_KEY=
PLANTNET_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Fase 5: Current Weather API; clave privada, sin NEXT_PUBLIC_.
OPENWEATHER_API_KEY=

# Fase 6: VAPID_PUBLIC_KEY se entrega al navegador; las demás claves son privadas.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
CRON_SECRET=
NOTIFICATIONS_ENABLED=false
# Correo de recordatorios opcional, independiente de Supabase Auth SMTP.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
# Solo para probar Service Workers con next dev. En producción no hace falta.
NEXT_PUBLIC_ENABLE_PWA_DEV=false
